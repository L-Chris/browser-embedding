{
  "schema_version": 1,
  "suite_id": "retrieval-frozen-v1",
  "description": "Frozen multilingual and scientific retrieval test suite for release comparisons.",
  "test_policy": {
    "allowed_use": "aggregate release evaluation only",
    "forbidden_use": "checkpoint selection, threshold tuning, prompt tuning, or per-query error-driven development",
    "revision_rule": "Any source, normalization, relevance, or metric change requires a new suite id."
  },
  "normalization": {
    "recipe_version": 1,
    "document_text": "strip(title) + ('\\n' when both fields are non-empty) + strip(text)",
    "query_text": "strip(text)",
    "ordering": "UTF-8 code-point order by id; qrels by query id then corpus id",
    "relevance": "retain qrels with integer score > 0; duplicate pairs keep maximum score",
    "queries": "retain only queries present in positive test qrels",
    "candidate_pool": "complete normalized corpus for each dataset"
  },
  "metrics": [
    "nDCG@10",
    "MAP@100",
    "MRR@10",
    "Recall@1",
    "Recall@3",
    "Recall@10",
    "Recall@100"
  ],
